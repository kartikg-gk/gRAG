# graphRAG configuration
#
# Copy this file to .env and fill in what you use. Every process — the CLI, the
# API, the worker — loads .env from its working directory when it starts. A
# variable already exported in the environment always wins over the file.
#
#   GRAPHRAG_ENV_FILE=path   load that file instead (it must exist)
#   GRAPHRAG_ENV_FILE=       load no file at all
#
# REQUIRED  the feature named beside it fails without it
# OPTIONAL  shown commented out, at its default
#
# Never commit .env. Values below are placeholders, not credentials.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# REQUIRED for the control plane (API keys, tenants, artifacts, the worker and
# the pod agent) and for query history. One Postgres serves all of them: set
# this and leave the two below unset. There is no default — unset, both raise
# when first used rather than falling back to a local file.
GRAPHRAG_DATABASE_URL=postgresql+psycopg://graphrag:change-me@localhost:5432/graphrag

# OPTIONAL. Move one of them to its own database. Each wins over
# GRAPHRAG_DATABASE_URL for its own tables when set.
# GRAPHRAG_CONTROL_PLANE_DATABASE_URL=
# GRAPHRAG_HISTORY_DATABASE_URL=

# OPTIONAL. Maximum control-plane read connections. Values below 1 are
# clamped to 1.
# GRAPHRAG_DB_POOL_SIZE=10


# ---------------------------------------------------------------------------
# Authentication and tenancy (HTTP API)
# ---------------------------------------------------------------------------

# REQUIRED for any API that anyone else can reach. Setting it is what turns
# session verification on. Unset, every request runs as GRAPHRAG_DEV_USER_ID
# and no token is checked. The only signal is one warning at startup. A
# misspelled variable name has the same effect.
GRAPHRAG_CLERK_ISSUER=

# OPTIONAL. Where the issuer publishes its signing keys. Unset, the issuer's
# /.well-known/jwks.json.
# GRAPHRAG_CLERK_JWKS_URL=

# OPTIONAL. Comma-separated azp values to accept. Empty means azp is not checked.
# GRAPHRAG_CLERK_AUTHORIZED_PARTIES=

# OPTIONAL.
# GRAPHRAG_JWKS_CACHE_SECONDS=300
# GRAPHRAG_DEV_USER_ID=dev-user

# OPTIONAL. Exactly 1, true or True turns tenancy on; any other value, or
# unset, means one tenant and no API key required. With tenancy on, the key is
# sent as Authorization: Bearer <key>.
# GRAPHRAG_MULTI_TENANCY_ENABLED=0
# GRAPHRAG_DEFAULT_TENANT_ORG_ID=dev-org-SINGLE-TENANT

# OPTIONAL. Browser origins allowed to call the API, comma-separated. The
# default * is fine for local use; set it to the frontend's origin in any
# deployment.
# GRAPHRAG_CORS_ORIGINS=*

# REQUIRED to use POST /api/admin/onboarding/provision, sent by the caller in the
# X-Admin-Secret header. Unset, that route answers 503 and provisions nothing.
# GRAPHRAG_ADMIN_SECRET_KEY=


# ---------------------------------------------------------------------------
# GitHub ingestion
# ---------------------------------------------------------------------------

# OPTIONAL. Public repositories work without it, at 60 requests/hour, which
# covers a dozen pull requests and not a real ingest. A token raises that to
# 5,000. Read from the environment only; there is no command-line flag.
GITHUB_TOKEN=

# REQUIRED to accept POST /api/webhooks/github. The secret set on the repository's
# webhook in GitHub; every delivery is checked against it. Unset, the route
# answers 503 to every delivery.
# GRAPHRAG_GITHUB_WEBHOOK_SECRET=

# REQUIRED for the GitHub OAuth connection flow. The callback default is the
# local API endpoint; change it to the registered callback in deployment.
# GRAPHRAG_GITHUB_CLIENT_ID=
# GRAPHRAG_GITHUB_CLIENT_SECRET=
# GRAPHRAG_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/callback
# GRAPHRAG_GITHUB_OAUTH_SCOPE=repo read:org

# REQUIRED to encrypt GitHub tokens at rest. Supply a urlsafe-base64 Fernet
# key encoding exactly 32 bytes. This is a placeholder, not a usable key.
# GRAPHRAG_ENCRYPTION_MASTER_KEY=

# OPTIONAL. Signs the OAuth state. Unset, GRAPHRAG_ADMIN_SECRET_KEY is used.
# GRAPHRAG_GITHUB_OAUTH_STATE_SECRET=


# ---------------------------------------------------------------------------
# Model judge (entity merges during ingest, intent routing at query time)
# ---------------------------------------------------------------------------

# OPTIONAL as a feature. Without it, ambiguous entity pairs are kept as
# separate entities, and a query matching no keyword marker is weighted as
# conceptual. Set all three together: a key with no URL or model fails when a
# judge is built. Any OpenAI-compatible endpoint works.
GRAPHRAG_JUDGE_KEY=
GRAPHRAG_JUDGE_BASE_URL=
GRAPHRAG_JUDGE_MODEL=

# OPTIONAL. A separate, faster endpoint for query-time routing. Set all three
# together; unset, the endpoint above answers routing too.
# GRAPHRAG_JUDGE_FAST_KEY=
# GRAPHRAG_JUDGE_FAST_BASE_URL=
# GRAPHRAG_JUDGE_FAST_MODEL=

# OPTIONAL. Routing budget: one attempt, then the conceptual fallback.
# GRAPHRAG_JUDGE_TIMEOUT_SECONDS=2.0
# GRAPHRAG_JUDGE_MAX_TOKENS=4

# OPTIONAL. Seconds one attempt at an answer or summary may take.
# GRAPHRAG_ANSWER_TIMEOUT_SECONDS=60


# ---------------------------------------------------------------------------
# Files and storage
#
# Relative paths resolve against the working directory, so a process started
# from a different directory gets a different, empty store. Use absolute paths
# for anything you want to keep.
# ---------------------------------------------------------------------------

# OPTIONAL. The local graph store the API serves. Unset, graph.lbug in the
# project root. Other graphs to switch between live in graphs/*.lbug.
#
# One process per store file. The engine locks the file while it is open, and
# a second process opening it is refused ("Could not set lock on file"). So
# build a graph before starting the API on it, or ingest into another file and
# switch to it; stop the API before rebuilding the file it serves. Tenant
# graphs are unaffected: each compile writes a fresh file the API has not
# opened.
# GRAPHRAG_STORE_PATH=graph.lbug
# GRAPHRAG_WARM_EMBEDDER=1
# GRAPHRAG_TRACE_DIR=.

# OPTIONAL. Where built artifacts are published. local suits one machine;
# pods on different machines cannot read each other's disks.
# GRAPHRAG_ARTIFACT_BACKEND=local
# GRAPHRAG_ARTIFACT_ROOT=artifacts
# GRAPHRAG_ARTIFACT_S3_PREFIX=artifacts

# REQUIRED when GRAPHRAG_ARTIFACT_BACKEND=cloud, together with boto3 installed
# and AWS credentials in the environment.
# GRAPHRAG_ARTIFACT_BUCKET=
# GRAPHRAG_ARTIFACT_REGION=


# ---------------------------------------------------------------------------
# Pod agent (keeps this process's graphs in step with the control plane)
# ---------------------------------------------------------------------------

# OPTIONAL. Runs only when this is exactly 1; "true" does not switch it on.
# GRAPHRAG_POD_AGENT=1

# OPTIONAL. The defaults only identify a single machine.
# GRAPHRAG_POD_ID=pod-local
# GRAPHRAG_POD_ADDRESS=127.0.0.1
# GRAPHRAG_POD_CACHE_ROOT=cache
# GRAPHRAG_RECONCILE_INTERVAL=5.0
# GRAPHRAG_POD_HEARTBEAT_WINDOW=120.0


# ---------------------------------------------------------------------------
# Compile worker and queue
# ---------------------------------------------------------------------------

# OPTIONAL. docker compose up -d starts a Redis at this address.
# GRAPHRAG_REDIS_URL=redis://localhost:6379/0
# GRAPHRAG_QUEUE_NAME=graphrag
# GRAPHRAG_DEBOUNCE_WINDOW=120.0
# GRAPHRAG_DEBOUNCE_MAX_WAIT=600.0
# GRAPHRAG_SWEEP_INTERVAL=30.0
# GRAPHRAG_COMPILE_LOCK_TTL=1800.0


# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------

# OPTIONAL. Changing any of these changes every ranking; measure before and after.
# GRAPHRAG_TOTAL_K=10
# GRAPHRAG_TOP_K_VECTOR=10
# GRAPHRAG_TOP_K_GRAPH=10
# GRAPHRAG_MIN_VECTOR_K=2
# GRAPHRAG_GRAPH_MAX_HOPS=2
# GRAPHRAG_MAX_DEGREE=10
# GRAPHRAG_GRAPH_NEIGHBOR_K=5
# GRAPHRAG_GRAPH_SEED_TOP_N=3
# GRAPHRAG_GRAPH_SEED_MIN_SIM=0.35

# OPTIONAL. Limits on the agent tools (find_entity, search_context,
# trace_impact): how far one trace walks and how much one call may return.
# GRAPHRAG_TOOL_MAX_HOPS=4
# GRAPHRAG_TOOL_MAX_IMPACT=50
# GRAPHRAG_TOOL_MAX_CANDIDATES=10
# GRAPHRAG_TOOL_CITATIONS_PER_NODE=2
# GRAPHRAG_TOOL_SNIPPET_CHARS=280
# GRAPHRAG_TOOL_NEIGHBOR_K=25
# GRAPHRAG_TOOL_SEED_MAX_DEGREE=200
# GRAPHRAG_TOOL_RESOLVE_MIN_SIM=0.40
# GRAPHRAG_MAX_QUERY_CHARS=2000
# GRAPHRAG_EMBED_WORKERS=4
# GRAPHRAG_QUERY_EXTRACT_CACHE=512
# GRAPHRAG_VECTOR_WEIGHT_RELATIONAL=0.15
# GRAPHRAG_GRAPH_WEIGHT_RELATIONAL=0.85
# GRAPHRAG_VECTOR_WEIGHT_CONCEPTUAL=0.80
# GRAPHRAG_GRAPH_WEIGHT_CONCEPTUAL=0.20
# GRAPHRAG_RECENCY_ENABLED=1
# GRAPHRAG_RECENCY_FLOOR=0.35
# GRAPHRAG_DEFAULT_HALF_LIFE_DAYS=90.0

# ---------------------------------------------------------------------------
# Error reporting
# ---------------------------------------------------------------------------

# OPTIONAL. Set to report errors and traces; needs the "sentry" extra installed.
# GRAPHRAG_SENTRY_DSN=
# GRAPHRAG_SENTRY_ENVIRONMENT=development
# GRAPHRAG_SENTRY_TRACES_SAMPLE_RATE=1.0
